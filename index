        let currentSize = 24; 
        let currentVerseIndex = 0;
        let correctOrder = [];
        let currentWords = [];
        let poolWords = [];
        let hintTimer; // 💡 5초 타이머용 변수 추가

        function changeSize(delta) {
            currentSize += delta;
            if (currentSize < 16) currentSize = 16; 
            if (currentSize > 40) currentSize = 40; 
            document.documentElement.style.setProperty('--base-size', currentSize + 'px');
        }

        function setMode(mode) {
            if(mode === 'game') {
                document.getElementById('game-list').style.display = 'flex';
                document.getElementById('read-list').style.display = 'none';
                document.getElementById('btn-tab-game').classList.add('active');
                document.getElementById('btn-tab-read').classList.remove('active');
            } else {
                document.getElementById('game-list').style.display = 'none';
                document.getElementById('read-list').style.display = 'flex';
                document.getElementById('btn-tab-game').classList.remove('active');
                document.getElementById('btn-tab-read').classList.add('active');
            }
        }

        function buildMenu() {
            const gameListDiv = document.getElementById('game-list');
            const readListDiv = document.getElementById('read-list');
            gameListDiv.innerHTML = '';
            readListDiv.innerHTML = '';

            verseDatabase.forEach((verse, index) => {
                const gameBtn = document.createElement('button');
                gameBtn.className = 'verse-item';
                gameBtn.innerText = verse.title;
                gameBtn.onclick = () => openGame(index);
                gameListDiv.appendChild(gameBtn);

                const readItem = document.createElement('div');
                readItem.className = 'read-item';
                readItem.innerHTML = `<div class="read-title">${verse.title}</div><div class="read-text">${verse.words.join(" ")}</div>`;
                readListDiv.appendChild(readItem);
            });
        }

        function showMenu() {
            document.getElementById('game-screen').classList.remove('active');
            document.getElementById('menu-screen').classList.add('active');
        }

        function openGame(index) {
            currentVerseIndex = index;
            document.getElementById('menu-screen').classList.remove('active');
            document.getElementById('game-screen').classList.add('active');
            document.getElementById('game-title').innerText = "📖 " + verseDatabase[index].title;
            correctOrder = verseDatabase[index].words;
            initGame();
        }

        function shuffle(array) {
            let currentIndex = array.length, randomIndex;
            while (currentIndex != 0) {
                randomIndex = Math.floor(Math.random() * currentIndex);
                currentIndex--;
                [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
            }
            return array;
        }

        function initGame() {
            currentWords = [];
            poolWords = shuffle([...correctOrder]);
            document.getElementById('message').style.display = 'none';
            document.getElementById('hint-box').style.display = 'none';
            
            // 💡 게임 시작 시 타이머 초기화
            if (hintTimer) clearTimeout(hintTimer); 
            
            render();
        }

        // 💡 5초 뒤에 자동으로 꺼지는 힌트 기능으로 업그레이드
        function toggleHint() {
            const hintBox = document.getElementById('hint-box');
            
            // 기존에 작동 중이던 타이머 취소
            if (hintTimer) clearTimeout(hintTimer);

            if (hintBox.style.display === 'block') {
                hintBox.style.display = 'none';
            } else {
                hintBox.innerText = correctOrder.join(" ");
                hintBox.style.display = 'block';
                
                // 5초(5000ms) 뒤에 화면에서 힌트 박스 숨기기
                hintTimer = setTimeout(() => {
                    hintBox.style.display = 'none';
                }, 5000);
            }
        }

        function moveToTarget(word, index) {
            poolWords.splice(index, 1);
            currentWords.push(word);
            render();
            checkWin();
        }

        function moveToPool(word, index) {
            currentWords.splice(index, 1);
            poolWords.push(word);
            render();
        }

        function render() {
            const targetDiv = document.getElementById('target');
            const poolDiv = document.getElementById('pool');
            
            targetDiv.innerHTML = '';
            poolDiv.innerHTML = '';

            if(currentWords.length === 0) {
                targetDiv.innerHTML = '<span style="color:#999; font-size: 0.8em;">아래 말씀 조각을 순서대로 눌러보세요</span>';
            } else {
                currentWords.forEach((word, index) => {
                    const btn = document.createElement('button');
                    btn.className = 'target-btn';
                    btn.innerText = word;
                    btn.onclick = () => moveToPool(word, index);
                    targetDiv.appendChild(btn);
                });
            }

            poolWords.forEach((word, index) => {
                const btn = document.createElement('button');
                btn.className = 'word-btn';
                btn.innerText = word;
                btn.onclick = () => moveToTarget(word, index);
                poolDiv.appendChild(btn);
            });
        }

        function playSuccessSound() {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return; 
            const ctx = new AudioContext();
            const notes = [659.25, 830.61, 987.77]; 
            let startTime = ctx.currentTime;

            notes.forEach((freq, i) => {
                const osc = ctx.createOscillator();
                const gainNode = ctx.createGain();
                osc.type = 'sine'; 
                osc.frequency.value = freq;
                osc.connect(gainNode);
                gainNode.connect(ctx.destination);
                osc.start(startTime + i * 0.15); 
                gainNode.gain.setValueAtTime(0.5, startTime + i * 0.15);
                gainNode.gain.exponentialRampToValueAtTime(0.01, startTime + i * 0.15 + 0.5);
                osc.stop(startTime + i * 0.15 + 0.5);
            });
        }

        function checkWin() {
            if (currentWords.length === correctOrder.length) {
                let isWin = true;
                for (let i = 0; i < correctOrder.length; i++) {
                    if (currentWords[i] !== correctOrder[i]) isWin = false;
                }
                if (isWin) {
                    document.getElementById('message').style.display = 'block';
                    document.getElementById('pool').innerHTML = ''; 
                    playSuccessSound();
                }
            }
        }

        buildMenu();

        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('sw.js');
        }
